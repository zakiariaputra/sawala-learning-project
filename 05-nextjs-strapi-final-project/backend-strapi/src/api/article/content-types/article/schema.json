{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": "Content Type untuk artikel sederhana (Final Project Minggu 9-10)"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text",
      "required": true
    },
    "content": {
      "type": "richtext",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "Teknologi",
        "Tutorial",
        "Web Development",
        "Opini"
      ],
      "default": "Tutorial"
    },
    "authorName": {
      "type": "string",
      "required": true
    }
  }
}
